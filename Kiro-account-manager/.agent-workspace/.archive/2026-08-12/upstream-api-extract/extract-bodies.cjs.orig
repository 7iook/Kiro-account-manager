// 逐函数体对比：index.ts 旧实现 vs upstreamApi/* 新实现。
// 判据不是「测试绿」而是「函数体逐字节等价」（抽取的预期行为变化为零，
// 故 diff 比测试更强的证据 —— 测试只能证明它跑过的那些路径）。
//
// 提取方式：从 `function <name>(` 那一行起，读到第一行「仅由缩进 + }」构成的行为止。
// 新实现在工厂闭包内，整体多两格缩进 —— 对比前按各自的基准缩进 dedent，
// 于是纯缩进差不产生 diff 噪声，真实差异才显形。
const fs = require('node:fs')
const path = require('node:path')

const ROOT = 'F:/Kiro-account-manager/Kiro-account-manager'
const OUT = path.join(ROOT, '.agent-workspace/.archive/2026-08-12/upstream-api-extract/bodies')

function extract(file, name) {
  const lines = fs.readFileSync(path.join(ROOT, file), 'utf-8').split(/\r?\n/)
  const startIdx = lines.findIndex((l) => new RegExp(`^\\s*(?:export\\s+)?(?:async\\s+)?function ${name}\\b`).test(l))
  if (startIdx < 0) throw new Error(`not found: ${name} in ${file}`)
  const indent = lines[startIdx].match(/^(\s*)/)[1]
  const closer = indent + '}'
  let endIdx = -1
  for (let i = startIdx + 1; i < lines.length; i++) {
    if (lines[i] === closer) { endIdx = i; break }
  }
  if (endIdx < 0) throw new Error(`no closer for ${name} in ${file}`)
  // dedent：去掉该函数的基准缩进
  const body = lines.slice(startIdx, endIdx + 1).map((l) => (l.startsWith(indent) ? l.slice(indent.length) : l))
  return body.join('\n') + '\n'
}

// [函数名, 新文件]  —— 旧侧一律 src/main/index.ts
const CASES = [
  ['getRestApiBase', 'src/main/upstreamApi/transport.ts'],
  ['getFallbackRestApiBase', 'src/main/upstreamApi/transport.ts'],
  ['getNetworkAgent', 'src/main/upstreamApi/transport.ts'],
  ['fetchWithAppProxy', 'src/main/upstreamApi/transport.ts'],
  ['kiroApiRequest', 'src/main/upstreamApi/transport.ts'],
  ['generateInvocationId', 'src/main/upstreamApi/transport.ts'],
  ['getKiroUserAgent', 'src/main/upstreamApi/transport.ts'],
  ['getKiroAmzUserAgent', 'src/main/upstreamApi/transport.ts'],
  ['refreshOidcToken', 'src/main/upstreamApi/refresh.ts'],
  ['refreshSocialToken', 'src/main/upstreamApi/refresh.ts'],
  ['validateMicrosoftTokenEndpoint', 'src/main/upstreamApi/refresh.ts'],
  ['refreshExternalIdpToken', 'src/main/upstreamApi/refresh.ts'],
  ['refreshTokenByMethod', 'src/main/upstreamApi/refresh.ts'],
  ['refreshTokenByMethodInner', 'src/main/upstreamApi/refresh.ts'],
  ['ssoDeviceAuth', 'src/main/upstreamApi/sso.ts'],
  ['normalizeResetDate', 'src/main/upstreamApi/usage.ts'],
  ['fetchRestApi', 'src/main/upstreamApi/usage.ts'],
  ['getUsageLimitsRest', 'src/main/upstreamApi/usage.ts'],
  ['getUsageAndLimits', 'src/main/upstreamApi/usage.ts'],
  ['getUserInfo', 'src/main/upstreamApi/usage.ts']
]

fs.mkdirSync(path.join(OUT, 'old'), { recursive: true })
fs.mkdirSync(path.join(OUT, 'new'), { recursive: true })
// CACHEDIR.TAG：让 Invoke-SafeClean 认得这棵临时树（首 43 字节精确匹配）
fs.writeFileSync(
  path.join(OUT, 'CACHEDIR.TAG'),
  'Signature: 8a477f597d28d172789f06886806bc55\n# temp extraction-diff tree, safe to remove\n'
)

let identical = 0
const differing = []
for (const [name, newFile] of CASES) {
  const oldBody = extract('src/main/index.ts', name)
  const newBody = extract(newFile, name)
  fs.writeFileSync(path.join(OUT, 'old', `${name}.ts`), oldBody)
  fs.writeFileSync(path.join(OUT, 'new', `${name}.ts`), newBody)
  if (oldBody === newBody) identical++
  else differing.push(name)
}

console.log(`TOTAL=${CASES.length} IDENTICAL=${identical} DIFFERING=${differing.length}`)
if (differing.length) console.log('DIFFERING: ' + differing.join(', '))
