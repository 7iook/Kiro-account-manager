# Required. The systemd unit creates this directory with mode 0700.
KIRO_DATA_DIR=/var/lib/kiro-account-manager

# Safe production default: only a same-host TLS front proxy can reach the panel.
KIRO_PANEL_HOST=127.0.0.1
KIRO_PANEL_PORT=5590

# Recommended log-free first boot: set a unique value of at least 32 characters.
# Keep /etc/kiro-account-manager/server.env mode 0600.
# KIRO_ADMIN_KEY=replace-with-a-password-manager-generated-secret

# Encrypts kiro-accounts.backup.enc (AES-256-GCM). A DIFFERENT secret from the
# admin key above -- these are deliberately separate key materials. At least 32
# characters. Without it the server refuses to write a plaintext backup, because
# that file holds account tokens and proxy credentials.
# Rotatable, but backups written with an older value still need that older value
# to decrypt. See docs/operations/key-handling.md.
# KIRO_BACKUP_KEY=replace-with-a-second-independent-secret

# Escape hatch: accept an unencrypted backup instead of refusing to write one.
# Only defensible on an isolated network where losing the backup is judged worse
# than storing it in the clear. Do not set this on an internet-facing host.
# KIRO_BACKUP_ALLOW_PLAINTEXT=1

# Logs are truncated by default. Enable full payload logs only for short, controlled diagnostics;
# they can contain credentials and consume substantial disk.
# KIRO_LOG_FULL=1

# Development-only escape hatch for platforms that cannot enforce POSIX mode 0600.
# Never set this in the Linux systemd deployment.
# KIRO_ALLOW_UNPROTECTED_KEY_FILE=1
